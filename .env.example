# LOCAL ONLY. Copy to .env (not committed). Never put real secrets in an archive.
# Evaluation launcher ignores this file entirely; recorded replay needs no key.
HOST=127.0.0.1
PORT=3000
# When you have a Clocked API key, put it BELOW and set the flag to true.
BEFOREROLL_LIVE_ENABLED=false
CLOCKED_API_KEY=
# The configuration launcher automatically generates separate local secrets:
BEFOREROLL_OWNER_TOKEN=
BEFOREROLL_OPERATOR_TOKEN=
BEFOREROLL_MAX_CALLS_PER_HOUR=256
# Optional: path to local pdftotext.exe for difficult text-layer PDFs
# BEFOREROLL_PDFTOTEXT_PATH=
